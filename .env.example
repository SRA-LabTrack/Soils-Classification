# Frontend-safe Appwrite configuration
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a787625002b311b4896
VITE_APPWRITE_DATABASE_ID=soils_database

# Table IDs
VITE_APPWRITE_PROFILES_TABLE_ID=profiles
VITE_APPWRITE_FARMS_TABLE_ID=farms
VITE_APPWRITE_SENSORS_TABLE_ID=sensor_stations
VITE_APPWRITE_READINGS_TABLE_ID=sensor_readings
VITE_APPWRITE_PLOTS_TABLE_ID=soil_plots
VITE_APPWRITE_ANALYSES_TABLE_ID=soil_analyses
VITE_APPWRITE_DRONE_TABLE_ID=drone_mappings
APPWRITE_SPATIAL_CHANGES_TABLE_ID=spatial_changes

# Satellite imagery. You can replace this later with your preferred tile provider.
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# SERVER-ONLY SECRET. Paste your Appwrite API key here.
# Never rename this to VITE_APPWRITE_API_KEY.
APPWRITE_API_KEY=

# Optional: create/update the real administrator when running setup:appwrite.
APPWRITE_ADMIN_EMAIL=
APPWRITE_ADMIN_PASSWORD=
APPWRITE_ADMIN_NAME=Soils Administrator

# Farmer accounts and all farm/map records are created only from the Admin UI.
